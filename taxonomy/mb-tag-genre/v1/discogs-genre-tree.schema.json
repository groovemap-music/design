{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://groovemap.music/schemas/discogs-genre-tree-v1.json",
  "title": "GrooveMap Discogs genre and style tree",
  "description": "The frozen genre to style target tree of mb-tag-genre/v1, built from the releases and masters of one named Discogs dump (ADR 0020).",
  "x-license": "MIT",
  "type": "object",
  "additionalProperties": false,
  "required": ["tree_version", "license", "source", "rule", "counts", "genres"],
  "properties": {
    "tree_version": { "const": "1" },
    "license": { "const": "MIT" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "license", "dump_date", "inputs"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "license": { "const": "CC0-1.0" },
        "dump_date": { "type": "string", "pattern": "^[0-9]{8}$" },
        "inputs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "kind", "records", "sha256"],
            "properties": {
              "file": { "type": "string", "pattern": "^discogs_[0-9]{8}_(masters|releases)\\.xml\\.gz$" },
              "kind": { "enum": ["masters", "releases"] },
              "records": { "type": "integer", "minimum": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "share_threshold", "dominant_parent_always_kept", "dropped_genres", "max_children_per_genre"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "share_threshold": { "const": "0.20" },
        "dominant_parent_always_kept": { "const": true },
        "dropped_genres": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "max_children_per_genre": { "const": 255 }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["genres", "styles", "pairs", "styles_with_2plus_parents", "max_children"],
      "properties": {
        "genres": { "type": "integer", "minimum": 1 },
        "styles": { "type": "integer", "minimum": 1 },
        "pairs": { "type": "integer", "minimum": 1 },
        "styles_with_2plus_parents": { "type": "integer", "minimum": 0 },
        "max_children": { "type": "integer", "minimum": 1, "maximum": 255 }
      }
    },
    "genres": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["genre", "records", "children"],
        "properties": {
          "genre": { "type": "string", "minLength": 1 },
          "records": { "type": "integer", "minimum": 1 },
          "children": {
            "type": "array",
            "minItems": 1,
            "maxItems": 255,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["style", "records", "genre_records"],
              "properties": {
                "style": { "type": "string", "minLength": 1 },
                "records": { "type": "integer", "minimum": 1 },
                "genre_records": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    }
  }
}
