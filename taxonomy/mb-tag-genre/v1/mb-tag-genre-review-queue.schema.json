{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://groovemap.music/schemas/mb-tag-genre-review-queue-v1.json",
  "title": "GrooveMap mb-tag-genre review queue",
  "description": "The pending rows of an mb-tag-genre/v1 lookup (both models name the same genre or style, or they disagree), most-used first, with Claude's answer as the default (ADR 0020).",
  "x-license": "MIT",
  "type": "object",
  "additionalProperties": false,
  "required": ["queue_version", "lookup", "default_rule", "counts", "rows"],
  "$defs": {
    "path": { "type": "array", "maxItems": 2, "items": { "type": "string", "minLength": 1 } },
    "count": { "type": "integer", "minimum": 0 }
  },
  "properties": {
    "queue_version": { "const": "1" },
    "lookup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "dump", "tree_dump_date"],
      "properties": {
        "file": { "type": "string", "pattern": "^[a-z0-9-]+\\.json$" },
        "dump": { "type": "string", "pattern": "^[0-9]{8}-[0-9]{6}$" },
        "tree_dump_date": { "type": "string", "pattern": "^[0-9]{8}$" }
      }
    },
    "default_rule": { "type": "string", "minLength": 1 },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows", "agree_genre", "disagree"],
      "properties": { "rows": { "$ref": "#/$defs/count" }, "agree_genre": { "$ref": "#/$defs/count" }, "disagree": { "$ref": "#/$defs/count" } }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tag", "uses", "bucket", "default", "jev", "claude", "jev_top3", "jev_separation"],
        "properties": {
          "tag": { "type": "string", "minLength": 1 },
          "uses": { "type": "integer", "minimum": 1 },
          "bucket": { "enum": ["agree_genre", "disagree"] },
          "default": { "$ref": "#/$defs/path" },
          "jev": { "$ref": "#/$defs/path" },
          "claude": { "oneOf": [{ "$ref": "#/$defs/path" }, { "type": "null" }] },
          "jev_top3": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "score"],
              "properties": { "path": { "$ref": "#/$defs/path" }, "score": { "type": "number", "minimum": 0, "maximum": 1 } }
            }
          },
          "jev_separation": { "type": "number", "minimum": 1 }
        }
      }
    }
  }
}
