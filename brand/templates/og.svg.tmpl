<svg xmlns="http://www.w3.org/2000/svg" width="{{WIDTH}}" height="{{HEIGHT}}" viewBox="0 0 1200 630" role="img" aria-labelledby="title desc">
  <title id="title">{{DISPLAY_NAME}}</title><desc id="desc">{{TAGLINE}}</desc>
  <defs><radialGradient id="bg"><stop stop-color="{{DEEP}}"/><stop offset="1" stop-color="{{BACKGROUND}}"/></radialGradient></defs>
  <rect width="1200" height="630" fill="url(#bg)"/>
  <g transform="translate(55 95) scale(.43)">{{MARK_BODY}}</g>
  <text x="555" y="285" fill="{{TEXT}}" font-family="system-ui,-apple-system,sans-serif" font-size="92" font-weight="750" letter-spacing="-3">{{DISPLAY_NAME}}</text>
  <text x="560" y="365" fill="{{CYAN}}" font-family="system-ui,-apple-system,sans-serif" font-size="38">music knowledge graph</text>
  <text x="560" y="425" fill="{{MUTED_TEXT}}" font-family="system-ui,-apple-system,sans-serif" font-size="28">{{DOMAIN}}</text>
  <path d="M0 626h1200" stroke="{{CYAN_GLOW}}" stroke-width="4" opacity=".75"/>
</svg>
